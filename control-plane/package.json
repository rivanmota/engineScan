{
  "name": "attack-sim-control-plane",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "dev:emulator": "firebase emulators:start --only firestore",
    "dev:all": "concurrently -k -n emulator,next \"npm:dev:emulator\" \"npm:dev\"",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "firebase-admin": "^12.6.0",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.8",
    "concurrently": "^9.0.1",
    "firebase-tools": "^13.35.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
