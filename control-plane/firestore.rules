rules_version = '2';

// All access goes through the Next.js server (Admin SDK), which bypasses
// these rules. This file only matters if the emulator/production database
// is ever accessed directly from a client SDK, which this app does not do.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
