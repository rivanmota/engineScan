# Copy to .env.local for local development against the Firestore emulator.

# Any non-empty project id works with the emulator.
GOOGLE_CLOUD_PROJECT=attack-sim-dev

# Points firebase-admin at the local Firestore emulator instead of real GCP.
# Must match the "firestore.port" in firebase.json.
FIRESTORE_EMULATOR_HOST=localhost:8090

# Port the Next.js app listens on (matches the agent's --control-plane URL).
PORT=4000

# --- Scheduled re-scans (see "Scheduled re-scans" in the README) ---

# Run due schedules from inside the Next.js server process. Fine for local
# dev and long-running `next start`; for serverless, set this to false and
# call POST /internal/schedules/run-due from a cron instead.
SCHEDULER_ENABLED=true

# How often the in-process scheduler checks for due schedules (default 60).
# SCHEDULER_TICK_SECONDS=60

# Enables POST /internal/schedules/run-due (send "Authorization: Bearer <secret>").
# Leave unset to disable that endpoint.
# SCHEDULER_SECRET=change-me
