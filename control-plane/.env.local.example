# Copy to .env.local for local development against the Firestore emulator.

# Any non-empty project id works with the emulator.
GOOGLE_CLOUD_PROJECT=attack-sim-dev

# Points firebase-admin at the local Firestore emulator instead of real GCP.
# Must match the "firestore.port" in firebase.json.
FIRESTORE_EMULATOR_HOST=localhost:8090

# Port the Next.js app listens on (matches the agent's --control-plane URL).
PORT=4000
